<!--PAGE-TITLE-->Forgot password | Grand Meridian Resort
<!--PAGE-CSS-->
<!--PAGE-BODY-->
<body class="auth-page auth-center">
<button class="icon-btn theme-float" data-theme-toggle data-theme-icon title="Toggle theme"></button>
<div class="auth-slim">
  <a href="index.html" class="logo" style="margin-bottom:1.6rem;display:inline-flex"><span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M20.2 2.8a6 6 0 0 0-8.5 0L5 9.5V19h9.5l6.7-6.7a6 6 0 0 0-1-9.5z"/><path d="M16 8 2 22M17.5 15H9"/></svg></span><span>Grand Meridian Resort</span></a>
  <div class="card card-pad" id="fpCard">
    <div class="mb-3"><h1 style="font-family:var(--display);font-size:1.5rem">Forgot password?</h1><p class="text-sm" style="color:var(--muted);margin-top:.3rem">Enter your account email and we'll send a secure reset link.</p></div>
    <form id="fpForm" novalidate>
      <div class="field">
        <label for="fpEmail">Email address</label>
        <div class="input-affix"><span data-icon="mail"></span><input class="input" type="email" id="fpEmail" placeholder="you@example.com" autocomplete="email"></div>
        <div class="err">Enter a valid email address.</div>
      </div>
      <button class="btn btn-primary btn-lg btn-block" type="submit" id="fpBtn"><span class="spin"></span><span class="lbl">Send reset link</span></button>
    </form>
    <p class="auth-foot"><a href="login.html">Back to sign in</a></p>
  </div>
</div>
</body>
<!--PAGE-JS-->
App.boot({guard:'guest'});
(function(){
  var form=document.getElementById('fpForm');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    App.clearErrors(form);
    var em=document.getElementById('fpEmail');
    var ok=App.fieldErrors([{id:'fpEmail',req:true,pattern:/^[^@\s]+@[^@\s]+\.[^@\s]+$/}]);
    if(!ok){ App.toast('Enter a valid email.','warning'); return; }
    var btn=document.getElementById('fpBtn'); btn.classList.add('loading'); btn.disabled=true;
    setTimeout(function(){
      btn.classList.remove('loading'); btn.disabled=false;
      var found=App.getUsers().filter(function(u){return u.email.toLowerCase()===em.value.toLowerCase().trim();}).length>0;
      document.getElementById('fpCard').innerHTML=
        '<div class="row" style="flex-direction:column;text-align:center;gap:1rem;padding:1rem 0">'+
        '<div class="kpi none" style="width:74px;height:74px" ><div class="ico ico-success" style="width:100%;height:100%">'+App.icon('checkCircle','icon-lg')+'</div></div>'+
        '<h1 style="font-family:var(--display);font-size:1.4rem">Check your inbox</h1>'+
        '<p class="text-sm" style="color:var(--muted)">'+(found?'If that address has an account, a reset link is on its way to <b>'+App.esc(em.value)+'</b>. For this prototype, click below to continue.':'We couldn\u2019t find that address, but you can still proceed with the demo flow.')+'</p>'+
        '<a class="btn btn-primary btn-lg" href="reset-password.html?email='+encodeURIComponent(em.value)+'">Continue to reset &rsaquo;</a>'+
        '<a class="btn btn-ghost btn-sm" href="login.html">Back to sign in</a></div>';
    },900);
  });
})();