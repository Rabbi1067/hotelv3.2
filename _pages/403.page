<!--PAGE-TITLE-->403 | Access denied
<!--PAGE-CSS-->
.err-page{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem}
.err-box{text-align:center;max-width:440px}
.err-code{font-size:8rem;font-weight:800;font-family:var(--display);line-height:.9;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:-.04em}
.err-code span{color:var(--text);background:none;-webkit-text-fill-color:var(--text)}
<!--PAGE-BODY-->
<body>
<div class="err-page">
  <div class="err-box">
    <div class="err-code">4<span>0</span>3</div>
    <div class="eyebrow" style="margin-top:1.2rem">Staff only</div>
    <h2 style="font-family:var(--display)">Access denied</h2>
    <p class="text-sm" style="color:var(--muted);margin:1rem 0">You don’t have permission to view this page. Sign in with an admin account to continue.</p>
    <div class="row" style="justify-content:center;gap:.7rem;flex-wrap:wrap">
      <a class="btn btn-primary" href="login.html">Sign in</a>
      <a class="btn btn-ghost" href="index.html">Back home</a>
    </div>
  </div>
</div>
</body>
<!--PAGE-JS-->
App.boot({});