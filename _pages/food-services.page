<!--PAGE-TITLE-->Food &amp; Services | Grand Meridian Resort
<!--PAGE-CSS-->
.cart-bar{position:sticky;top:calc(var(--topbar-h) + 12px);z-index:700;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:.85rem 1rem;display:flex;align-items:center;gap:.9rem;margin-bottom:1.4rem}
.cart-bar .cb-tot{margin-left:auto;font-weight:800;font-size:1.1rem}
.cat-tabs{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.3rem}
.cat-tabs button{border:1px solid var(--border);background:var(--surface);border-radius:99px;padding:.45rem .95rem;font-weight:600;font-size:.85rem;color:var(--muted);cursor:pointer;font-family:var(--font);transition:.14s}
.cat-tabs button.active{background:var(--primary);color:#fff;border-color:var(--primary)}
<!--PAGE-BODY-->
<body data-chrome="dash" data-active="ufs">
<div class="app">
  <div class="sidebar" id="sidebar"></div>
  <header class="topbar" id="topbar"></header>
  <main>
    <div class="page-wrap">
      <div class="section-title"><div class="eyebrow">Order to your door</div><h2 style="font-family:var(--display)">Food &amp; in-room services</h2><p>Breakfast, lunch, dinner, snacks and hotel services delivered to your room.</p></div>

      <div class="cart-bar" id="cartBar" style="display:none">
        <span class="ico ico-accent" style="width:40px;height:40px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center"><span data-icon="utensils"></span></span>
        <div><div class="strong text-sm">Your order</div><div class="text-xs" style="color:var(--muted)" id="cartQtyLab"></div></div>
        <span class="cb-tot" id="cbTot"></span>
        <a class="btn btn-primary btn-sm" href="food-cart.html">Review cart</a>
      </div>

      <div class="cat-tabs" id="catTabs"></div>
      <div id="loader">
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr))"><div class="sk" style="height:230px"></div><div class="sk" style="height:230px"></div><div class="sk" style="height:230px"></div><div class="sk" style="height:230px"></div></div>
      </div>
      <div class="grid svc-grid" id="svcGrid" style="display:none"></div>
    </div>
  </main>
</div>
</body>
<!--PAGE-JS-->
App.boot({guard:'user'});
App.renderDashChrome('ufs','Food & Services',[{label:'Dashboard',href:'dashboard.html'},{label:'Food & Services',href:'#'}]);
(function(){
  var food=App.getFood().filter(function(f){ return f.available!==false; });
  var cats=['All'].concat(food.map(function(f){return f.cat;}).filter(function(v,i,a){return a.indexOf(v)===i;}));
  var cur='All';
  var tabs=document.getElementById('catTabs');
  tabs.innerHTML=cats.map(function(c){ return '<button class="'+(c===cur?'active':'')+'" data-c="'+c+'">'+c+'</button>'; }).join('');
  tabs.addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b)return;
    cur=b.dataset.c; tabs.querySelectorAll('button').forEach(function(x){x.classList.toggle('active',x===b);});
    render();
  });
  function cart(){ return App.LS.get('hv_cart',[]); }
  function saveCart(c){ App.LS.set('hv_cart',c); updateBar(); }
  function inCart(id){ var c=cart().filter(function(x){return x.id===id;})[0]; return c?c.qty:0; }
  var grid=document.getElementById('svcGrid');
  function render(){
    var list=food.filter(function(f){ return cur==='All'||f.cat===cur; });
    grid.style.display='';
    grid.innerHTML=list.map(function(f){
      var q=inCart(f.id);
      return '<div class="svc-card"><div class="svc-img"><img src="'+f.img+'" alt="'+App.esc(f.name)+'" loading="lazy" onerror="this.style.background=\'#0d3a36\'"><span class="cat">'+f.cat+'</span></div>'+
        '<div class="svc-body"><h4>'+f.name+'</h4><p>'+App.esc(f.desc)+'</p>'+
        '<div class="svc-foot"><span class="svc-price">'+App.money(f.price)+'</span>'+
        (q?'<div class="qty"><button class="btn-rm" data-dec="'+f.id+'" aria-label="Remove">'+App.icon('minus','icon-sm')+'</button><span class="q">'+q+'</span><button class="btn-add" data-inc="'+f.id+'" aria-label="Add">'+App.icon('plus','icon-sm')+'</button></div>':'<button class="btn btn-primary btn-sm" data-add="'+f.id+'">Add</button>')+
        '</div></div></div>';
    }).join('');
    if(!list.length) grid.innerHTML=App.emptyState('utensils','Nothing here','No items in this category yet.');
  }
  grid.addEventListener('click',function(e){
    var add=e.target.closest('[data-add]'), inc=e.target.closest('[data-inc]'), dec=e.target.closest('[data-dec]');
    if(add) change(add.dataset.add,1,false);
    if(inc) change(inc.dataset.inc,1,true);
    if(dec) change(dec.dataset.dec,-1,true);
  });
  function change(id,delta,quiet){
    var c=cart(); var it=c.filter(function(x){return x.id===id;})[0];
    if(!it){ if(delta<0)return; c.push({id:id,qty:delta}); }
    else { it.qty+=delta; if(it.qty<=0)c=c.filter(function(x){return x.id!==id;}); }
    saveCart(c);
    if(!quiet){
      var f=food.filter(function(x){return x.id===id;})[0];
      App.toast(f.name+' added to order.');
    }
    render();
  }
  function updateBar(){
    var c=cart(); var n=c.reduce(function(a,b){return a+b.qty;},0);
    var tot=c.reduce(function(a,b){ var f=food.filter(function(x){return x.id===b.id;})[0]; return a+(f?f.price*b.qty:0); },0);
    var bar=document.getElementById('cartBar');
    if(!n){ bar.style.display='none'; return; }
    bar.style.display='flex';
    document.getElementById('cartQtyLab').textContent=n+' item'+(n>1?'s':'')+' &bull; delivered to your room';
    document.getElementById('cbTot').textContent=App.money(tot);
  }
  setTimeout(function(){ document.getElementById('loader').style.display='none'; render(); updateBar(); },420);
  updateBar();
})();