<!--PAGE-TITLE-->Room WiFi | Grand Meridian Resort
<!--PAGE-CSS-->
.wifi-page{display:grid;grid-template-columns:1.1fr 1fr;gap:1.5rem;align-items:start}
.qr-box{background:#fff;border-radius:12px;padding:.9rem;display:inline-flex;flex-direction:column;align-items:center;gap:.4rem;box-shadow:var(--shadow)}
.qr-box canvas{width:150px;height:150px;display:block}
.qr-box .ql{font-size:.68rem;color:#333;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
@media (max-width:992px){.wifi-page{grid-template-columns:1fr}}
<!--PAGE-BODY-->
<body data-chrome="dash" data-active="uw">
<div class="app">
  <div class="sidebar" id="sidebar"></div>
  <header class="topbar" id="topbar"></header>
  <main>
    <div class="page-wrap">
      <div class="section-title"><div class="eyebrow">Stay connected</div><h2 style="font-family:var(--display)">Room WiFi</h2><p>Network details for your current and upcoming stays. Password appears once your stay is confirmed.</p></div>

      <div class="wifi-page">
        <div id="mainWifi"></div>
        <div>
          <div class="card mb-3">
            <div class="card-head"><h3>Connect steps</h3></div>
            <div class="card-body" id="howTo">
              <ol class="grid" style="gap:.6rem;padding-left:1.1rem;color:var(--muted);font-size:.9rem">
                <li>Open your device's <b>WiFi settings</b>.</li>
                <li>Select the network name (SSID) shown for your room.</li>
                <li>Enter the password — it's case-sensitive.</li>
                <li>Open any page; you'll connect automatically.</li>
              </ol>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><h3>Other stays</h3></div>
            <div id="otherWifi"></div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
</body>
<!--PAGE-JS-->
App.boot({guard:'user'});
App.renderDashChrome('uw','WiFi',[{label:'Dashboard',href:'dashboard.html'},{label:'WiFi',href:'#'}]);
(function(){
  var cu=App.getCurrentUser();
  var books=App.getBookings().filter(function(b){return b.userId===cu.id&&b.status!=='cancelled';});
  var main=books.filter(function(b){return b.status==='active';})[0]||books.filter(function(b){return b.status==='confirmed';})[0];
  var mainBox=document.getElementById('mainWifi');
  if(!main){
    mainBox.innerHTML=App.emptyState('wifi','No active stay','WiFi credentials appear here when you have an active or upcoming booking.','<a class="btn btn-primary btn-sm" href="search-rooms.html">Book a room</a>');
  } else {
    var w=App.wifiForBooking(main);
    mainBox.innerHTML='<div class="wifi-card"><div class="wc-label"><span data-icon="wifi"></span> '+App.esc(w.label)+'</div>'+
      '<div class="wc-ssid">'+App.esc(w.ssid)+'</div>'+
      '<div class="text-sm" style="color:rgba(255,255,255,.75)">'+App.esc(main.roomName)+' &bull; '+main.bookingId+'</div>'+
      '<div class="wifi-row"><span class="k">Password</span><span class="v" id="wPass"></span><button class="btn btn-accent btn-sm" id="wToggle">Show</button></div>'+
      '<div class="wifi-row"><span class="k">Connection</span><span class="v" style="letter-spacing:0;font-size:.82rem">— port '+((main.nights%98)+5020)+'</span></div>'+
      '<div class="row" style="gap:1.2rem;align-items:center;flex-wrap:wrap;margin-top:.6rem">'+
      '<div class="qr-box" id="qrBox"><canvas id="qrCanvas" width="300" height="300"></canvas><span class="ql">Scan to connect</span></div>'+
      '<div style="color:rgba(255,255,255,.85);font-size:.85rem;max-width:220px">Point your camera at the QR code to join instantly. &bull; '+App.esc(w.instructions)+'</div>'+
      '</div></div>';
    drawQR(main);
    var passBill='';
    function masked(){ return (passBill=String(w.password||'').replace(/./g,'\u2022')); }
    var passEl=document.getElementById('wPass');
    passEl.textContent=masked();
    document.getElementById('wToggle').addEventListener('click',function(){
      if(this.textContent==='Show'){ passEl.textContent=w.password; this.textContent='Hide'; }
      else { passEl.textContent=masked(); this.textContent='Show'; }
    });
  }
  function drawQR(b){
    var c=document.getElementById('qrCanvas'); if(!c)return;
    var ctx=c.getContext('2d'); ctx.clearRect(0,0,300,300);
    var cells=21, cs=300/cells;
    var data=('WIFI:T:WPA;S:'+w.ssid+';P:'+w.password+';;');
    var hash=function(s){ var h=0; for(var i=0;i<s.length;i++){h=(h*31+s.charCodeAt(i))>>>0;} return h; };
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,300,300);
    ctx.fillStyle='#0d524d';
    function drawFinder(x,y){ ctx.fillRect(x*cs,y*cs,7*cs,7*cs); ctx.fillStyle='#fff'; ctx.fillRect((x+1)*cs,(y+1)*cs,5*cs,5*cs); ctx.fillStyle='#0d524d'; ctx.fillRect((x+2)*cs,(y+2)*cs,3*cs,3*cs); }
    drawFinder(0,0); drawFinder(14,0); drawFinder(0,14);
    var rng=hash(data);
    for(var y=0;y<cells;y++){ for(var x=0;x<cells;x++){
      if((x<8&&y<8)||(x>=cells-8&&y<8)||(x<8&&y>=cells-8))continue;
      rng=(rng*1103515245+12345)>>>0;
      if(rng%100<47){ ctx.fillRect(x*cs+1,y*cs+1,cs-2,cs-2); }
    } }
    ctx.fillStyle='#fff'; ctx.fillRect(9*cs,9*cs,3*cs,3*cs);
  }
  var others=books.filter(function(b){return b.id!==main.id;}).slice(0,4);
  var ow=document.getElementById('otherWifi');
  if(!others.length) ow.innerHTML='<div class="card-body"><p class="text-sm" style="color:var(--muted)">No other stays.</p></div>';
  else ow.innerHTML=others.map(function(b){
    var w2=App.wifiForBooking(b);
    return '<div class="recent-row"><img src="'+b.roomImage+'" alt=""><div><div class="rr-title">'+App.esc(b.roomName)+'</div><div class="rr-sub">'+App.fmtDate(b.checkIn)+' &rarr; '+App.fmtDate(b.checkOut)+'</div></div><div style="text-align:right"><div class="text-xs strong">'+App.esc(w2.ssid)+'</div><span class="badge '+(b.status==='confirmed'?'b-primary':'b-plain')+'">'+App.cap(b.status)+'</span></div></div>';
  }).join('');

})();