<!--PAGE-TITLE-->Reset password | Grand Meridian Resort
<!--PAGE-CSS-->
.strength{height:5px;border-radius:99px;background:var(--surface-3);margin-top:.5rem;overflow:hidden}
.strength i{display:block;height:100%;width:0;transition:.3s;border-radius:99px}
<!--PAGE-BODY-->
<body class="auth-page auth-center">
<button class="icon-btn theme-float" data-theme-toggle data-theme-icon title="Toggle theme"></button>
<div class="auth-slim">
  <a href="index.html" class="logo" style="margin-bottom:1.6rem;display:inline-flex"><span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M20.2 2.8a6 6 0 0 0-8.5 0L5 9.5V19h9.5l6.7-6.7a6 6 0 0 0-1-9.5z"/><path d="M16 8 2 22M17.5 15H9"/></svg></span><span>Grand Meridian Resort</span></a>
  <div class="card card-pad">
    <div class="mb-3"><h1 style="font-family:var(--display);font-size:1.5rem">Choose a new password</h1><p class="text-sm" style="color:var(--muted);margin-top:.3rem" id="rEmailNote">Set a fresh password for your account.</p></div>
    <form id="rpForm" novalidate>
      <div class="field">
        <label for="rpPass">New password</label>
        <div class="input-affix right pass-row"><span data-icon="lock"></span><input class="input" type="password" id="rpPass" placeholder="Min 6 characters" autocomplete="new-password"></div>
        <div class="strength"><i id="strBar"></i></div>
        <div class="hint" id="strHint">Use 8+ characters with letters &amp; numbers.</div>
      </div>
      <div class="field">
        <label for="rpPass2">Confirm new password</label>
        <div class="input-affix right pass-row"><span data-icon="lock"></span><input class="input" type="password" id="rpPass2" placeholder="Repeat new password" autocomplete="new-password"></div>
        <div class="err">Passwords do not match.</div>
      </div>
      <button class="btn btn-primary btn-lg btn-block" type="submit"><span class="spin"></span><span class="lbl">Update password</span></button>
    </form>
    <p class="auth-foot"><a href="login.html">Back to sign in</a></p>
  </div>
</div>
</body>
<!--PAGE-JS-->
App.boot({guard:'guest'});
(function(){
  var em=new URLSearchParams(location.search).get('email');
  if(em) document.getElementById('rEmailNote').textContent='Resetting the password for '+em+'.';
  var pw=document.getElementById('rpPass'), bar=document.getElementById('strBar'), hint=document.getElementById('strHint');
  function score(s){
    var n=0;
    if(s.length>=6)n+=1; if(s.length>=10)n+=1; if(/[A-Z]/.test(s)&&/[a-z]/.test(s))n+=1; if(/\d/.test(s))n+=1; if(/[^A-Za-z0-9]/.test(s))n+=1;
    return n;
  }
  pw.addEventListener('input',function(){
    var s=score(pw.value), colors=['','#dfa326','#2d8a57','#2d8a57','#0d524d'], labels=['Too short','Fair','Good','Strong','Excellent'];
    bar.style.width=(s/5*100)+'%';
    bar.style.background=colors[s];
    hint.textContent=labels[s]+(s<2?' \u2014 use 8+ characters with letters &amp; numbers':'');
  });
  var form=document.getElementById('rpForm');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    App.clearErrors(form);
    var ok=App.fieldErrors([{id:'rpPass',req:true,pattern:/^.{6,}$/}]);
    if(!ok){ App.toast('Password must be at least 6 characters.','warning'); return; }
    if(document.getElementById('rpPass2').value!==pw.value){ document.getElementById('rpPass2').closest('.field').classList.add('show-err'); App.toast('Passwords do not match.','warning'); return; }
    var btn=form.querySelector('button[type=submit]'); btn.classList.add('loading'); btn.disabled=true;
    setTimeout(function(){
      App.toast('Password updated. You can now sign in.');
      setTimeout(function(){ location.replace('login.html'); },900);
    },800);
  });
})();